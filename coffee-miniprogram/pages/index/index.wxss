.hero {
  position: relative;
  height: 800rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  transform: scale(1.02);
}

.hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(7, 6, 5, 0.72) 0%, rgba(7, 6, 5, 0.1) 36%, rgba(7, 6, 5, 0.25) 58%, #0b0908 100%),
    linear-gradient(90deg, rgba(7, 6, 5, 0.55) 0%, transparent 65%);
}

.hero-top {
  position: absolute;
  top: 0;
  left: 40rpx;
  right: 40rpx;
  padding-top: 190rpx;
}

.hero-copy {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 96rpx;
}

.hero-date {
  display: block;
  font-size: 20rpx;
  color: rgba(244, 238, 230, 0.56);
  letter-spacing: 0.12em;
  margin-bottom: 22rpx;
}

.hero-title {
  display: block;
  font-size: 80rpx;
  line-height: 1.16;
  letter-spacing: 0.03em;
  color: #fdf8f0;
  text-shadow: 0 6rpx 40rpx rgba(0, 0, 0, 0.5);
}

.hero-title.second {
  color: var(--gold-bright);
}

.hero-rule {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 28rpx;
}

.rule-line {
  width: 64rpx;
  height: 1rpx;
  background: var(--gold);
  opacity: 0.5;
}

.hero-desc {
  font-size: 20rpx;
  color: rgba(244, 238, 230, 0.55);
  letter-spacing: 0.1em;
}

/* 搜索 */
.search-entry {
  position: relative;
  z-index: 2;
  margin: -50rpx 36rpx 0;
  height: 100rpx;
  padding: 0 16rpx 0 30rpx;
  border-radius: 50rpx;
  background: rgba(24, 20, 17, 0.92);
  border: 1rpx solid var(--line);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.42);
  -webkit-backdrop-filter: blur(20rpx);
  backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.8;
}

.search-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--muted-2);
  letter-spacing: 0.02em;
}

.search-action {
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(100deg, #b99261, #dcc099);
  color: #15100c;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 门店条 */
.store-strip {
  margin: 26rpx 40rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.store-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.live-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--sage);
  box-shadow: 0 0 0 6rpx rgba(143, 169, 138, 0.1);
}

.store-title {
  font-size: 20rpx;
  color: var(--text);
  letter-spacing: 0.04em;
}

.store-hours {
  font-size: 19rpx;
  color: var(--muted-2);
}

.store-right {
  font-size: 19rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
  opacity: 0.8;
}

/* 区块头 */
.section-head > view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.section-sub {
  display: block;
}

.section-title {
  display: block;
}

/* 分类 */
.category-scroll {
  white-space: nowrap;
  padding: 4rpx 0 10rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 142rpx;
  margin-right: 16rpx;
}

.category-ring {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 169, 126, 0.24);
  background: radial-gradient(circle at 30% 25%, rgba(200, 169, 126, 0.16), rgba(200, 169, 126, 0.03) 65%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  position: relative;
}

.category-ring::after {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 169, 126, 0.1);
}

.category-code {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.1em;
}

.category-name {
  font-size: 24rpx;
  color: var(--text);
  letter-spacing: 0.04em;
}

.category-en {
  font-size: 14rpx;
  color: var(--muted-2);
  letter-spacing: 0.1em;
  margin-top: 4rpx;
}

/* 推荐 */
.recommend-scroll {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.recommend-card {
  position: relative;
  display: inline-block;
  width: 328rpx;
  height: 442rpx;
  margin-right: 22rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid var(--line-soft);
  background: var(--card);
  vertical-align: top;
}

.recommend-img {
  width: 100%;
  height: 100%;
}

.recommend-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(7, 6, 5, 0.05) 30%, rgba(7, 6, 5, 0.7) 62%, rgba(7, 6, 5, 0.96) 100%);
}

.recommend-tag {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  padding: 5rpx 14rpx;
  border: 1rpx solid rgba(200, 169, 126, 0.35);
  border-radius: 6rpx;
  background: rgba(11, 9, 8, 0.4);
  color: var(--gold-bright);
  font-size: 17rpx;
  letter-spacing: 0.08em;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.recommend-copy {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
}

.recommend-name {
  display: block;
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 33rpx;
  color: #fdf8f0;
  letter-spacing: 0.04em;
}

.recommend-sub {
  display: block;
  font-size: 18rpx;
  color: rgba(244, 238, 230, 0.5);
  margin-top: 9rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.recommend-price {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 32rpx;
  color: var(--gold-bright);
}

.recommend-arrow {
  font-size: 28rpx;
  color: var(--gold);
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
}

.product-card {
  background: var(--card);
  border: 1rpx solid var(--line-soft);
  border-radius: 24rpx;
  overflow: hidden;
}

.product-media {
  position: relative;
  height: 300rpx;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-badge {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(11, 9, 8, 0.55);
  border: 1rpx solid rgba(200, 169, 126, 0.28);
  color: var(--gold-bright);
  font-size: 16rpx;
  letter-spacing: 0.08em;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.product-plus {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(11, 9, 8, 0.62);
  border: 1rpx solid rgba(200, 169, 126, 0.4);
  color: var(--gold-bright);
  font-size: 30rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.product-body {
  padding: 18rpx 20rpx 22rpx;
}

.product-name {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  letter-spacing: 0.02em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-sub {
  display: block;
  font-size: 18rpx;
  color: var(--muted-2);
  margin-top: 7rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
}

.product-price {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 30rpx;
  color: var(--gold-bright);
}

.product-sales {
  font-size: 16rpx;
  color: var(--muted-2);
}

.sk-line {
  height: 20rpx;
  margin-bottom: 14rpx;
}

.sk-line.small {
  height: 16rpx;
}

/* 加载更多 */
.load-more {
  margin: 42rpx auto 0;
  width: 260rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--gold);
  font-size: 21rpx;
  letter-spacing: 0.1em;
}

.load-line {
  width: 48rpx;
  height: 1rpx;
  background: var(--gold);
  opacity: 0.3;
}

/* 底部品牌 */
.brand-footer {
  padding: 80rpx 40rpx 20rpx;
  text-align: center;
}

.footer-en {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 18rpx;
  color: var(--gold);
  letter-spacing: 0.32em;
  opacity: 0.5;
}

.footer-cn {
  display: block;
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 0.14em;
  margin-top: 10rpx;
}

.footer-note {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-style: italic;
  font-size: 17rpx;
  color: var(--muted-2);
  letter-spacing: 0.04em;
  margin-top: 18rpx;
  opacity: 0.5;
}

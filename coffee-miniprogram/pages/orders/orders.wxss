.head {
  padding: 28rpx 36rpx 24rpx;
}

.head-title {
  display: block;
  font-size: 54rpx;
  line-height: 1.2;
  margin-top: 14rpx;
  letter-spacing: 0.04em;
}

.head-desc {
  display: block;
  font-size: 20rpx;
  color: var(--muted-2);
  margin-top: 12rpx;
}

.just-ordered {
  position: relative;
  margin: 0 36rpx 22rpx;
  padding: 26rpx 30rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(200, 169, 126, 0.35);
  background: linear-gradient(135deg, rgba(200, 169, 126, 0.16), rgba(200, 169, 126, 0.02));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.jo-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.jo-label {
  font-size: 18rpx;
  color: var(--gold);
  letter-spacing: 0.1em;
}

.jo-code {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 50rpx;
  color: var(--gold-bright);
  line-height: 1.1;
  letter-spacing: 0.1em;
}

.jo-note {
  font-size: 18rpx;
  color: var(--muted-2);
}

.jo-close {
  font-size: 40rpx;
  color: var(--muted-2);
  padding: 10rpx;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 36rpx 18rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  padding: 0 30rpx;
  margin-right: 12rpx;
  border-radius: 31rpx;
  border: 1rpx solid var(--line-soft);
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 0.03em;
}

.tab.active {
  background: var(--gold-dim);
  border-color: rgba(200, 169, 126, 0.4);
  color: var(--gold-bright);
}

.list {
  padding: 4rpx 36rpx 0;
}

.order-card {
  padding: 26rpx;
  margin-bottom: 22rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
  border-radius: 26rpx;
  animation: fadeUp 0.4s ease both;
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.order-no {
  display: block;
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 0.04em;
}

.order-time {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.status-pill {
  padding: 5rpx 16rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  letter-spacing: 0.06em;
  border: 1rpx solid transparent;
  flex-shrink: 0;
}

.status-pill.pending {
  color: #c9a25f;
  background: rgba(201, 162, 95, 0.1);
  border-color: rgba(201, 162, 95, 0.25);
}

.status-pill.making {
  color: #9db4c0;
  background: rgba(157, 180, 192, 0.1);
  border-color: rgba(157, 180, 192, 0.25);
}

.status-pill.ready {
  color: #8fa98a;
  background: rgba(143, 169, 138, 0.12);
  border-color: rgba(143, 169, 138, 0.28);
}

.status-pill.done {
  color: var(--muted);
  background: rgba(139, 131, 120, 0.08);
  border-color: rgba(139, 131, 120, 0.2);
}

.status-pill.cancelled {
  color: var(--wine);
  background: rgba(178, 106, 92, 0.09);
  border-color: rgba(178, 106, 92, 0.22);
}

.order-items {
  padding: 8rpx 0;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.oi-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--card-2);
}

.oi-body {
  flex: 1;
  min-width: 0;
}

.oi-name {
  display: block;
  font-size: 24rpx;
  color: var(--text);
}

.oi-spec {
  display: block;
  font-size: 18rpx;
  color: var(--muted-2);
  margin-top: 5rpx;
}

.oi-right {
  text-align: right;
  flex-shrink: 0;
}

.oi-price {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 24rpx;
  color: var(--muted);
}

.oi-qty {
  display: block;
  font-size: 17rpx;
  color: var(--muted-2);
  margin-top: 4rpx;
}

.order-total {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line-soft);
}

.ot-label {
  font-size: 19rpx;
  color: var(--muted-2);
}

.ot-value {
  font-size: 19rpx;
  color: var(--muted);
}

.ot-price {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 32rpx;
  color: var(--gold-bright);
  margin-left: 6rpx;
}

.order-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action {
  height: 66rpx;
  padding: 0 28rpx;
  border-radius: 33rpx;
  font-size: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.04em;
}

.action.ghost {
  border: 1rpx solid var(--line);
  color: var(--muted);
}

.action.gold {
  background: var(--gold-dim);
  border: 1rpx solid rgba(200, 169, 126, 0.4);
  color: var(--gold-bright);
}

.pickup {
  margin-left: auto;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.pickup-k {
  font-size: 18rpx;
  color: var(--muted-2);
}

.pickup-v {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 36rpx;
  color: var(--gold-bright);
  letter-spacing: 0.08em;
}

.load-state {
  padding: 24rpx 0 12rpx;
  text-align: center;
  font-size: 19rpx;
  color: var(--muted-2);
  letter-spacing: 0.12em;
}

.signin {
  padding: 100rpx 44rpx;
  text-align: center;
}

.signin-mark {
  display: block;
  font-size: 100rpx;
  line-height: 1;
  color: var(--gold);
  opacity: 0.25;
}

.signin-title {
  display: block;
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 36rpx;
  margin-top: 24rpx;
}

.signin-desc {
  display: block;
  font-size: 21rpx;
  color: var(--muted-2);
  margin-top: 14rpx;
}

.signin-btn {
  margin: 50rpx auto 0;
  width: 360rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 300rpx;
}

.sk-card {
  height: 300rpx;
  border-radius: 26rpx;
  margin-bottom: 22rpx;
}

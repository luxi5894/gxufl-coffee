.hero {
  position: relative;
  height: 560rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(7, 6, 5, 0.6) 0%, transparent 38%, rgba(7, 6, 5, 0.3) 70%, #0b0908 100%),
    linear-gradient(90deg, rgba(7, 6, 5, 0.45), transparent 65%);
}

.hero-copy {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 88rpx;
}

.hero-title {
  display: block;
  font-size: 84rpx;
  letter-spacing: 0.16em;
  line-height: 1.1;
  margin-top: 16rpx;
  color: #fdf8f0;
}

.hero-sub {
  display: block;
  font-size: 19rpx;
  color: var(--gold-bright);
  letter-spacing: 0.22em;
  margin-top: 12rpx;
}

.sheet {
  position: relative;
  z-index: 2;
  margin-top: -50rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #0b0908;
  border-top: 1rpx solid var(--line-soft);
  padding-top: 12rpx;
}

.section {
  margin-top: 52rpx;
}

.section.first {
  margin-top: 40rpx;
}

.section-head > view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.section-sub {
  display: block;
}

.text-block {
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.body-text {
  font-size: 23rpx;
  color: var(--muted);
  line-height: 2;
  letter-spacing: 0.02em;
}

.concepts {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.concept {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.concept-num {
  font-size: 40rpx;
  color: var(--gold);
  opacity: 0.55;
  line-height: 1;
  width: 58rpx;
  flex-shrink: 0;
}

.concept-body {
  flex: 1;
}

.concept-title {
  display: block;
  font-size: 26rpx;
  color: var(--text);
  letter-spacing: 0.03em;
  margin-bottom: 10rpx;
}

.concept-desc {
  display: block;
  font-size: 21rpx;
  color: var(--muted-2);
  line-height: 1.8;
}

.origin-list {
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
  overflow: hidden;
}

.origin {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.origin:last-child {
  border-bottom: none;
}

.origin-code {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: var(--gold-dim);
  color: var(--gold);
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.origin-copy {
  flex: 1;
  min-width: 0;
}

.origin-name {
  display: block;
  font-size: 24rpx;
  color: var(--text);
}

.origin-coffee {
  display: block;
  font-size: 18rpx;
  color: var(--gold);
  opacity: 0.75;
  margin-top: 5rpx;
}

.origin-en {
  font-size: 14rpx;
  color: var(--muted-2);
  letter-spacing: 0.1em;
}

.info-card {
  padding: 6rpx 26rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--gold);
  opacity: 0.85;
  letter-spacing: 0.04em;
}

.info-value {
  flex: 1;
  font-size: 22rpx;
  color: var(--text);
  line-height: 1.5;
}

.brand-footer {
  padding: 70rpx 40rpx 10rpx;
  text-align: center;
}

.footer-en {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 17rpx;
  color: var(--gold);
  letter-spacing: 0.3em;
  opacity: 0.45;
}

.footer-cn {
  display: block;
  font-size: 17rpx;
  color: var(--muted-2);
  letter-spacing: 0.12em;
  margin-top: 10rpx;
}

.footer-note {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-style: italic;
  font-size: 16rpx;
  color: var(--muted-2);
  margin-top: 16rpx;
  opacity: 0.5;
}

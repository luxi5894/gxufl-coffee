.hero {
  position: relative;
  height: 620rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(180deg, rgba(7, 6, 5, 0.55) 0%, rgba(7, 6, 5, 0.08) 35%, rgba(7, 6, 5, 0.42) 70%, #0b0908 100%),
    linear-gradient(90deg, rgba(7, 6, 5, 0.45), transparent 60%);
}

.hero-copy {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 96rpx;
}

.brand-en {
  display: block;
  font-size: 96rpx;
  line-height: 1;
  letter-spacing: 0.18em;
  color: #fdf8f0;
  text-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.45);
}

.brand-cn {
  display: block;
  font-size: 20rpx;
  color: var(--gold-bright);
  letter-spacing: 0.18em;
  margin-top: 18rpx;
}

.brand-desc {
  display: block;
  font-size: 21rpx;
  color: rgba(244, 238, 230, 0.55);
  letter-spacing: 0.04em;
  margin-top: 18rpx;
}

.sheet {
  position: relative;
  z-index: 2;
  margin-top: -70rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: linear-gradient(180deg, #0e0c0a, #0b0908);
  border-top: 1rpx solid var(--line-soft);
  padding: 36rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  min-height: 640rpx;
}

.tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx solid var(--line-soft);
  margin-bottom: 34rpx;
}

.tab {
  flex: 1;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 0.12em;
  transition: all 0.2s;
}

.tab.active {
  background: var(--gold-dim);
  color: var(--gold-bright);
  border: 1rpx solid rgba(200, 169, 126, 0.25);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  font-size: 19rpx;
  color: var(--gold);
  letter-spacing: 0.12em;
  margin-bottom: 12rpx;
  opacity: 0.85;
}

.field-box {
  height: 96rpx;
  padding: 0 26rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
}

.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 25rpx;
  color: var(--text);
}

.ph {
  color: var(--muted-2);
}

.eye {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 0.04em;
  padding: 10rpx 0 10rpx 16rpx;
}

.submit {
  width: 100%;
  margin-top: 14rpx;
}

.submit.disabled {
  opacity: 0.5;
}

.demo-hint {
  margin-top: 30rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  border: 1rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.demo-label {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 0.08em;
}

.demo-value {
  font-size: 19rpx;
  color: var(--gold);
  letter-spacing: 0.04em;
}

.agreement {
  display: block;
  text-align: center;
  font-size: 17rpx;
  color: var(--muted-2);
  margin-top: 26rpx;
  letter-spacing: 0.02em;
  opacity: 0.8;
}

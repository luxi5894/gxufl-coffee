.intro {
  padding: 28rpx 36rpx 24rpx;
}

.intro-title {
  display: block;
  font-size: 54rpx;
  line-height: 1.2;
  margin-top: 14rpx;
  letter-spacing: 0.04em;
}

.intro-desc {
  display: block;
  font-size: 20rpx;
  color: var(--muted-2);
  margin-top: 12rpx;
}

.tabs {
  display: flex;
  margin: 0 36rpx 24rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.025);
  border: 1rpx solid var(--line-soft);
}

.tab {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  font-size: 23rpx;
  color: var(--muted);
  letter-spacing: 0.1em;
}

.tab.active {
  background: var(--gold-dim);
  color: var(--gold-bright);
  border: 1rpx solid rgba(200, 169, 126, 0.25);
}

.form-card {
  margin: 0 36rpx;
  padding: 28rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.block-label {
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.12em;
}

.block-note {
  font-size: 18rpx;
  color: var(--muted-2);
}

.product-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line-soft);
  background: rgba(255, 255, 255, 0.018);
}

.picker-img,
.picker-placeholder {
  width: 92rpx;
  height: 92rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--card-2);
}

.picker-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  font-size: 32rpx;
}

.picker-copy {
  flex: 1;
  min-width: 0;
}

.picker-name {
  display: block;
  font-size: 25rpx;
  color: var(--text);
}

.picker-sub {
  display: block;
  font-size: 17rpx;
  color: var(--muted-2);
  margin-top: 5rpx;
}

.picker-arrow {
  font-size: 34rpx;
  color: var(--muted-2);
}

.rating-head {
  margin-top: 34rpx;
}

.rating-row {
  display: flex;
  gap: 20rpx;
}

.rating-star {
  font-size: 58rpx;
  color: rgba(200, 169, 126, 0.16);
  line-height: 1;
  transition: color 0.15s;
}

.rating-star.on {
  color: var(--gold);
}

.content-head {
  margin-top: 34rpx;
}

.content {
  width: 100%;
  height: 220rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  border: 1rpx solid var(--line-soft);
  background: rgba(255, 255, 255, 0.018);
  font-size: 22rpx;
  color: var(--text);
  line-height: 1.7;
}

.ph {
  color: var(--muted-2);
}

.submit {
  width: 100%;
  margin-top: 28rpx;
}

.submit.disabled {
  opacity: 0.5;
}

.section {
  margin-top: 54rpx;
}

.section-head > view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.section-sub {
  display: block;
}

.review-card {
  margin: 0 36rpx 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.review-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--gold-dim);
  border: 1rpx solid var(--line);
  color: var(--gold);
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-name {
  flex: 1;
  font-size: 21rpx;
  color: var(--text);
}

.review-time {
  font-size: 17rpx;
  color: var(--muted-2);
}

.stars {
  display: flex;
  gap: 4rpx;
  margin-top: 12rpx;
}

.s {
  font-size: 18rpx;
  color: rgba(200, 169, 126, 0.16);
}

.s.on {
  color: var(--gold);
}

.review-content {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 10rpx;
}

.list {
  padding: 0 36rpx;
}

.my-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.my-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-img {
  width: 84rpx;
  height: 84rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: var(--card-2);
}

.my-copy {
  flex: 1;
  min-width: 0;
}

.my-product {
  display: block;
  font-size: 24rpx;
  color: var(--text);
}

.my-time {
  display: block;
  font-size: 17rpx;
  color: var(--muted-2);
  margin-top: 6rpx;
}

.status {
  font-size: 17rpx;
  color: var(--muted-2);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid var(--line-soft);
}

.status.show {
  color: var(--sage);
  border-color: rgba(143, 169, 138, 0.25);
}

.my-content {
  display: block;
  font-size: 21rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 8rpx;
}

.empty-btn {
  margin: 40rpx auto 0;
  width: 300rpx;
}

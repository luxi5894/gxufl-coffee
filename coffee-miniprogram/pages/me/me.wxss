.profile-card {
  position: relative;
  margin: 28rpx 36rpx 0;
  padding: 30rpx 30rpx 8rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: linear-gradient(150deg, rgba(200, 169, 126, 0.09), rgba(255, 255, 255, 0.015) 55%), var(--card);
  border: 1rpx solid var(--line);
}

.profile-glow {
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 169, 126, 0.16), transparent 65%);
}

.profile-top {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-tag {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(200, 169, 126, 0.3);
  font-size: 16rpx;
  color: var(--gold);
  letter-spacing: 0.08em;
}

.user-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 30rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 169, 126, 0.4);
  background: linear-gradient(145deg, #b99261, #dcc099);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-char {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 46rpx;
  color: #15100c;
}

.user-copy {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.user-name {
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 40rpx;
  color: var(--text);
  letter-spacing: 0.03em;
}

.edit {
  font-size: 17rpx;
  color: var(--muted-2);
  border-bottom: 1rpx solid var(--line);
}

.user-phone {
  display: block;
  font-size: 19rpx;
  color: var(--muted-2);
  margin-top: 8rpx;
  letter-spacing: 0.06em;
}

.stats-row {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--line-soft);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 38rpx;
  color: var(--gold-bright);
  line-height: 1;
}

.stat-label {
  font-size: 17rpx;
  color: var(--muted-2);
  letter-spacing: 0.06em;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--line-soft);
}

.guest-card {
  position: relative;
  margin: 28rpx 36rpx 0;
  padding: 50rpx 36rpx 44rpx;
  border-radius: 28rpx;
  text-align: center;
  overflow: hidden;
  background: linear-gradient(150deg, rgba(200, 169, 126, 0.08), rgba(255, 255, 255, 0.012) 55%), var(--card);
  border: 1rpx solid var(--line);
}

.guest-glow {
  position: absolute;
  left: 50%;
  top: -120rpx;
  width: 340rpx;
  height: 340rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(200, 169, 126, 0.13), transparent 65%);
}

.guest-mark {
  position: relative;
  display: block;
  font-size: 70rpx;
  color: var(--gold);
  opacity: 0.3;
  line-height: 1;
}

.guest-title {
  position: relative;
  display: block;
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 38rpx;
  margin-top: 18rpx;
  letter-spacing: 0.04em;
}

.guest-desc {
  position: relative;
  display: block;
  font-size: 20rpx;
  color: var(--muted-2);
  margin-top: 12rpx;
}

.guest-btn {
  position: relative;
  margin: 34rpx auto 0;
  width: 320rpx;
}

.menu-group {
  margin: 22rpx 36rpx 0;
  border-radius: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 26rpx;
  border-bottom: 1rpx solid var(--line-soft);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 66rpx;
  height: 66rpx;
  border-radius: 16rpx;
  background: var(--gold-dim);
  border: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon {
  width: 34rpx;
  height: 34rpx;
}

.menu-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.menu-label {
  font-size: 25rpx;
  color: var(--text);
  letter-spacing: 0.02em;
}

.menu-sub {
  font-size: 17rpx;
  color: var(--muted-2);
}

.menu-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: var(--gold);
  color: #15100c;
  font-size: 17rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-arrow {
  font-size: 34rpx;
  color: var(--muted-2);
  line-height: 1;
}

.logout {
  margin: 26rpx 36rpx 0;
  height: 84rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--muted-2);
  letter-spacing: 0.1em;
}

.brand-footer {
  padding: 60rpx 40rpx 10rpx;
  text-align: center;
}

.footer-en {
  display: block;
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 17rpx;
  color: var(--gold);
  letter-spacing: 0.3em;
  opacity: 0.45;
}

.footer-cn {
  display: block;
  font-size: 17rpx;
  color: var(--muted-2);
  letter-spacing: 0.12em;
  margin-top: 10rpx;
}

.footer-ver {
  display: block;
  font-size: 15rpx;
  color: var(--muted-2);
  opacity: 0.5;
  margin-top: 12rpx;
  letter-spacing: 0.06em;
}

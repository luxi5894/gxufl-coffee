.hero {
  position: relative;
  height: 720rpx;
  overflow: hidden;
}

.swiper,
.swiper-img {
  width: 100%;
  height: 720rpx;
}

.hero-shade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(7, 6, 5, 0.35) 0%, transparent 30%, rgba(7, 6, 5, 0.2) 70%, #0b0908 100%);
  pointer-events: none;
}

.hero-counter {
  position: absolute;
  right: 32rpx;
  bottom: 84rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(11, 9, 8, 0.55);
  border: 1rpx solid rgba(200, 169, 126, 0.24);
  font-size: 18rpx;
  color: var(--gold-bright);
  letter-spacing: 0.12em;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.sheet {
  position: relative;
  z-index: 2;
  margin-top: -46rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: linear-gradient(180deg, #0d0b09, #0b0908);
  padding: 38rpx 36rpx 0;
  border-top: 1rpx solid var(--line-soft);
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.rating {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
}

.star {
  font-size: 22rpx;
  color: var(--gold);
}

.rating-num {
  font-size: 23rpx;
  color: var(--text);
  font-weight: 500;
}

.sales {
  font-size: 18rpx;
  color: var(--muted-2);
}

.product-name {
  display: block;
  font-size: 58rpx;
  line-height: 1.2;
  color: var(--text);
  margin-top: 24rpx;
  letter-spacing: 0.03em;
}

.product-sub {
  display: block;
  font-size: 21rpx;
  color: var(--muted-2);
  margin-top: 12rpx;
  line-height: 1.6;
}

.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 26rpx;
}

.price-main .symbol {
  font-size: 24rpx;
}

.stock-text {
  font-size: 18rpx;
  color: var(--muted-2);
  letter-spacing: 0.04em;
}

.desc {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.9;
  letter-spacing: 0.02em;
}

.block {
  margin-top: 46rpx;
}

.block-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.block-label {
  display: block;
  font-size: 24rpx;
  color: var(--gold);
  letter-spacing: 0.12em;
}

.block-note {
  font-size: 18rpx;
  color: var(--muted-2);
}

.spec-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-chip {
  min-height: 74rpx;
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-soft);
  background: var(--card);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 3rpx;
}

.spec-chip.active {
  background: var(--gold-dim);
  border-color: rgba(200, 169, 126, 0.5);
}

.spec-name {
  font-size: 23rpx;
  color: var(--text);
}

.spec-chip.active .spec-name {
  color: var(--gold-bright);
}

.spec-delta {
  font-size: 16rpx;
  color: var(--muted-2);
}

.stepper {
  display: inline-flex;
  align-items: center;
  border: 1rpx solid var(--line-soft);
  border-radius: 999rpx;
  background: var(--card);
  padding: 6rpx;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--gold);
  background: rgba(200, 169, 126, 0.07);
}

.step-btn.disabled {
  color: var(--muted-2);
  background: transparent;
}

.step-num {
  min-width: 90rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.archive {
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
}

.archive-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}

.archive-k {
  width: 120rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--muted-2);
  letter-spacing: 0.08em;
}

.archive-v {
  flex: 1;
  font-size: 23rpx;
  color: var(--text);
  line-height: 1.5;
}

.archive-tags {
  flex: 1;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.archive-tag {
  padding: 3rpx 14rpx;
  border-radius: 6rpx;
  background: var(--gold-dim);
  border: 1rpx solid rgba(200, 169, 126, 0.18);
  font-size: 18rpx;
  color: var(--gold);
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.review {
  padding: 22rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 1rpx solid var(--line-soft);
}

.review-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.review-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--gold-dim);
  border: 1rpx solid var(--line);
  color: var(--gold);
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--text);
}

.review-time {
  font-size: 17rpx;
  color: var(--muted-2);
}

.review-stars {
  margin-top: 12rpx;
  display: flex;
  gap: 4rpx;
}

.review-star {
  font-size: 18rpx;
  color: rgba(200, 169, 126, 0.16);
}

.review-star.on {
  color: var(--gold);
}

.review-content {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-top: 10rpx;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: calc(128rpx + env(safe-area-inset-bottom));
  padding: 16rpx 28rpx env(safe-area-inset-bottom);
  background: rgba(14, 12, 10, 0.94);
  border-top: 1rpx solid var(--line-soft);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.cart-entry {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-icon {
  width: 44rpx;
  height: 44rpx;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: -4rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: var(--gold);
  color: #15100c;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-price {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  flex-shrink: 0;
}

.bp-label {
  font-size: 16rpx;
  color: var(--muted-2);
  letter-spacing: 0.08em;
}

.bp-value {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 34rpx;
  color: var(--gold-bright);
  line-height: 1;
}

.bp-symbol {
  font-size: 20rpx;
  margin-right: 2rpx;
}

.bottom-btns {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.add-btn {
  height: 84rpx;
  padding: 0 28rpx;
  border-radius: 42rpx;
  border: 1rpx solid var(--line);
  color: var(--gold);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.buy-btn {
  height: 84rpx;
  padding: 0 34rpx;
  border-radius: 42rpx;
  background: linear-gradient(100deg, #b99261, #dcc099);
  color: #15100c;
  font-size: 23rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.06em;
  white-space: nowrap;
}

.sk {
  height: 22rpx;
  margin-top: 26rpx;
}

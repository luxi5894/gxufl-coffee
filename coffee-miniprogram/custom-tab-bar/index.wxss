.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: flex-start;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 10rpx 12rpx env(safe-area-inset-bottom);
  background: rgba(11, 9, 8, 0.92);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(200, 169, 126, 0.1);
}

.tab-item {
  flex: 1;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.icon-wrap {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 50%;
  transition: background 0.25s ease;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

.icon-wrap.active {
  background: rgba(200, 169, 126, 0.1);
}

.icon-wrap.active::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(200, 169, 126, 0.18);
}

.featured .icon {
  width: 44rpx;
  height: 44rpx;
}

.label {
  font-size: 18rpx;
  color: #8e857b;
  letter-spacing: 0.04em;
  line-height: 1.2;
}

.label.active {
  color: #c8a97e;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: #c8a97e;
  color: #15100c;
  font-size: 16rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0b0908;
}

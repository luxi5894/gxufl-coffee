.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(11, 9, 8, 0.9);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--line-soft);
}

.nav.transparent {
  background: linear-gradient(180deg, rgba(7, 6, 5, 0.72) 0%, rgba(7, 6, 5, 0.18) 70%, transparent 100%);
  border-bottom: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.back {
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text);
}

.arrow {
  font-family: 'Times New Roman', serif;
  font-size: 56rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.title-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 420rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  letter-spacing: 0.08em;
}

.sub {
  font-size: 16rpx;
  color: var(--gold);
  letter-spacing: 0.16em;
  margin-top: 2rpx;
  opacity: 0.8;
}

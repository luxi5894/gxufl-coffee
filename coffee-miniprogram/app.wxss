/** GXUFL Coffee Atelier · Global Theme */

page {
  --ink: #0b0908;
  --ink-soft: #100d0b;
  --card: #15110f;
  --card-2: #1b1714;
  --gold: #c8a97e;
  --gold-bright: #e4c99f;
  --gold-dim: rgba(200, 169, 126, 0.12);
  --line: rgba(200, 169, 126, 0.14);
  --line-soft: rgba(200, 169, 126, 0.08);
  --text: #f4eee6;
  --muted: #9c9287;
  --muted-2: #6f665e;
  --sage: #8fa98a;
  --wine: #b26a5c;

  background: var(--ink);
  color: var(--text);
  font-family: 'Avenir Next', 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 27rpx;
  line-height: 1.5;
  letter-spacing: 0.02em;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button,
scroll-view,
image {
  box-sizing: border-box;
}

.page-bg {
  min-height: 100vh;
  background:
    radial-gradient(120% 60% at 80% -10%, rgba(200, 169, 126, 0.09), transparent 60%),
    linear-gradient(180deg, #0b0908 0%, #0c0a09 50%, #0b0908 100%);
}

.container {
  padding-left: 36rpx;
  padding-right: 36rpx;
}

.tab-space {
  height: 200rpx;
}

.display {
  font-family: 'Didot', 'Times New Roman', 'Songti SC', 'Noto Serif CJK SC', serif;
  font-weight: 400;
}

.eyebrow {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
}

.section {
  padding: 0 36rpx;
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-title {
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 40rpx;
  font-weight: 400;
  color: var(--text);
  letter-spacing: 0.05em;
}

.section-sub {
  font-size: 19rpx;
  color: var(--muted-2);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section-more {
  font-size: 22rpx;
  color: var(--gold);
  letter-spacing: 0.06em;
}

.card {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.028), transparent 42%), var(--card);
  border: 1rpx solid var(--line-soft);
  border-radius: 24rpx;
  overflow: hidden;
}

.price {
  font-family: 'Didot', 'Times New Roman', serif;
  color: var(--gold-bright);
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(200, 169, 126, 0.25);
  border-radius: 6rpx;
  font-size: 18rpx;
  color: var(--gold);
  letter-spacing: 0.08em;
}

.btn-gold {
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(100deg, #b99261, #dcc099 55%, #c8a97e);
  color: #15100c;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 16rpx 40rpx rgba(200, 169, 126, 0.14);
}

.btn-gold::after {
  border: none;
}

.btn-gold.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.btn-outline {
  height: 92rpx;
  border-radius: 46rpx;
  border: 1rpx solid var(--line);
  background: transparent;
  color: var(--gold);
  font-size: 27rpx;
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-outline::after {
  border: none;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-soft);
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gold);
  font-size: 28rpx;
}

.divider {
  height: 1rpx;
  background: var(--line-soft);
  margin: 32rpx 0;
}

.price-line {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-main {
  font-family: 'Didot', 'Times New Roman', serif;
  font-size: 40rpx;
  color: var(--gold-bright);
  line-height: 1;
}

.price-main .symbol {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.price-origin {
  font-size: 20rpx;
  color: var(--muted-2);
  text-decoration: line-through;
}

.empty {
  padding: 110rpx 40rpx;
  text-align: center;
}

.empty .mark {
  display: block;
  font-family: 'Didot', 'Times New Roman', 'Songti SC', serif;
  font-size: 88rpx;
  color: var(--gold);
  opacity: 0.28;
  line-height: 1;
}

.empty .title {
  display: block;
  margin-top: 22rpx;
  font-size: 28rpx;
  color: var(--text);
  letter-spacing: 0.04em;
}

.empty .desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--muted-2);
}

.empty .action {
  margin: 34rpx auto 0;
  width: 300rpx;
}

.skeleton {
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.035) 20%, rgba(255, 255, 255, 0.07) 40%, rgba(255, 255, 255, 0.035) 60%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite linear;
  border-radius: 16rpx;
}

@keyframes shimmer {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}

.fade-up {
  animation: fadeUp 0.5s ease both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.hairline {
  height: 1rpx;
  background: var(--line-soft);
}

input,
textarea {
  color: var(--text);
}
